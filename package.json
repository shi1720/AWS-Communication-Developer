{
  "name": "secondcrate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A second destination for cancelled wholesale food orders.",
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && tsup src/server/index.ts src/server/lambda.ts --format esm --platform node --target node22 --out-dir dist-server --sourcemap --external @aws-sdk/*",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "infra:synth": "cdk synth --app 'npx tsx infra/app.ts'",
    "deploy": "cdk deploy --app 'npx tsx infra/app.ts' --require-approval never",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"infra/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1137.0",
    "@aws-sdk/client-dynamodb": "^3.1137.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "@aws-sdk/client-socialmessaging": "^3.1137.0",
    "@aws-sdk/client-sts": "^3.1137.0",
    "@aws-sdk/lib-dynamodb": "^3.1137.0",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@google-cloud/firestore": "^9.2.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.2",
    "fastify": "^5.12.5",
    "lucide-react": "^1.47.0",
    "mailparser": "^3.9.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1142.0",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
