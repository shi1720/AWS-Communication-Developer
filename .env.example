# Local development needs no AWS keys. `npm run dev` starts web :5279 and API :3279.
PORT=3279
HOST=127.0.0.1
AWS_REGION=eu-west-2
ALLOW_REGISTRATION=true
LIVE_SENDS_ENABLED=false

# AWS profile credentials belong in the AWS CLI, never in this repository.
# AWS_PROFILE=secondcrate
# BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# DYNAMODB_TABLE=your-deployed-table
# APP_ORIGIN=https://your-cloudfront-distribution.cloudfront.net

# Amazon SES: use a verified sender; sandbox recipients must also be verified
# or be SES simulator addresses. Setup guide: docs/AWS_DEPLOYMENT.md.
# SES_FROM_EMAIL=operator@your-verified-domain.example
# SES_REPLY_TO_EMAIL=replies@your-verified-domain.example
# SES_CONFIGURATION_SET=secondcrate-events
# SES_INBOUND_RECIPIENT=replies@your-verified-domain.example
# SES_OPERATOR_SENDERS=operator@your-verified-domain.example

# WhatsApp: approved MARKETING template for offers, opt-in required.
# WHATSAPP_PHONE_NUMBER_ID=phone-number-id-your-provisioned-id
# WHATSAPP_META_API_VERSION=v23.0
# WHATSAPP_OFFER_TEMPLATE=secondcrate_recovery_offer
# WHATSAPP_TEMPLATE_LANGUAGE=en_GB

# AWS End User Messaging SMS v2
# SMS_ORIGINATION_IDENTITY=your-provisioned-number-id
# SMS_ORIGINATION_ARN=arn:aws:sms-voice:REGION:ACCOUNT:phone-number/ID
# SMS_CONFIGURATION_SET=secondcrate-events
# SMS_PROTECT_CONFIGURATION_ID=your-protect-configuration

# Inbound routing is restricted to an explicitly provisioned live workspace.
# SINGLE_LIVE_WORKSPACE_ID=ws_your-real-workspace
# TRUSTED_SNS_TOPIC_ARN=arn:aws:sns:REGION:ACCOUNT:your-inbound-topic
# INBOUND_MAIL_BUCKET=your-deployed-private-bucket
# OPS_EMAIL=your-operations-address@example.com
